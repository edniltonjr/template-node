# Em produção este arquivo é gerado pelo deploy na VPS. Localmente, copie para .env.
PORT=__APP_PORT__
APP_NAME=__APP_NAME__
APP_DOMAIN=__APP_DOMAIN__

# Presentes se o projeto foi criado com banco:
# DATABASE_URL=postgresql://usuario:senha@100.64.0.2:5432/banco
# REDIS_URL=redis://usuario:senha@100.64.0.2:6379
# Chaves Redis devem usar o prefixo "__APP_NAME__:" (o usuário ACL só acessa esse prefixo).
